# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sushifusion?schema=public"

# Auth / JWT
JWT_SECRET="sushi_fusion_super_secret_jwt_key"

# Server Port
PORT=3001

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe Payments (Optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend Email (Optional)
RESEND_API_KEY=""

# Redis (Optional - for order background queue)
REDIS_HOST="localhost"
REDIS_PORT="6379"
